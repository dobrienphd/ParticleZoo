prefix=@prefix@
exec_prefix=${prefix}
libdir=@libdir@
includedir=${prefix}/include

Name: particlezoo
Description: High-performance C++20 library for reading, writing, and converting Monte Carlo particle phase space files
URL: https://github.com/dobrienphd/ParticleZoo
Version: @version@
Libs: -L${libdir} -lparticlezoo
Cflags: -I${includedir}
